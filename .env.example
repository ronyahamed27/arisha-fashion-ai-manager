# Copy this file to .env for local testing.
# On Render, add these as Environment Variables (do not upload .env).

PORT=10000

# Generate your own long random string; use the same value in Meta Webhooks.
VERIFY_TOKEN=replace_with_a_long_random_secret

# Meta App Dashboard > App settings > Basic > App Secret
META_APP_SECRET=replace_with_meta_app_secret

# Messenger Settings > Generate access tokens > select your Page > copy token
PAGE_ACCESS_TOKEN=replace_with_page_access_token

# Meta Page ID for Arisha Fashion
PAGE_ID=1519952511197335

# Graph API version. Check Meta's current supported version when upgrading.
META_GRAPH_VERSION=v26.0

# OpenAI API key (separate from ChatGPT subscription)
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
