PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Render PostgreSQL হলে সাধারণত DATABASE_URL Render থেকে নেবেন
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

META_VERIFY_TOKEN=CHANGE_ME
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0

STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd/api/v1
# Messenger/AI ও Courier চালু করতে সংশ্লিষ্ট credentials আবশ্যক
TIMEZONE=Asia/Dhaka
